# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = tab
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{js,ts,html}]
indent_size = 2

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.{md,cff}]
indent_style = space
max_line_length = off
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
indent_style = space
