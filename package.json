{
  "name": "ion-calendar",
  "version": "7.17.3",
  "type": "module",
  "scripts": {
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format . && prettier --check \"src/**/*.html\"",
    "format:fix": "biome format --write . && prettier --write \"src/**/*.html\"",
    "check": "biome check && prettier --check \"src/**/*.html\"",
    "check:fix": "biome check --write && prettier --write \"src/**/*.html\"",
    "prepare": "npm run build && cd dist/ion-calendar && npm link && cd ../../projects/demo && npm link @heliomarpm/ion-calendar",
    "prebuild": "rimraf -rf dist",
    "build": "ng build ion-calendar",
    "build:demo": "ng build demo",
    "package": "npm run build && cd dist/ion-calendar && npm pack",
    "start:demo": "ng serve demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "upversion": "node upversion.js",
    "deploy": "node ./node_modules/gh_deploy/index.mjs",
    "clear": "rimraf -rf node_modules dist .angular package-lock.json"
  },
  "private": false,
  "dependencies": {
    "@angular/animations": "^17.3.12",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "@angular/router": "^17.3.12",
    "@ionic/angular": "^7.4.3",
    "luxon": "^3.4.3",
    "ng-packagr": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.11",
    "@angular/cli": "~17.3.11",
    "@angular/compiler-cli": "^17.3.12",
    "@biomejs/biome": "2.5.12",
    "@types/jasmine": "~4.3.0",
    "@types/luxon": "^3.3.3",
    "gh_deploy": "github:heliomarpm/gh_deploy",
    "jasmine-core": "~4.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "rimraf": "^6.1.3",
    "semver": "^7.7.3",
    "typescript": "~5.4.5"
  },
  "allowScripts": {
    "esbuild@0.20.1": true,
    "esbuild@0.21.5": true
  }
}
